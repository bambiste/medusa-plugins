{
  "name": "@bambiste/medusa-qr",
  "version": "0.0.2",
  "description": "A starter for Medusa plugins.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bambiste/medusa-plugins.git",
    "directory": "packages/medusa-qr"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*",
    "./.medusa/server/src/modules/qr": "./.medusa/server/src/modules/qr/index.js",
    "./modules/*": "./.medusa/server/src/modules/*",
    "./providers/*": "./.medusa/server/src/providers/*",
    "./*": "./.medusa/server/src/*.js",
    ".": "./.medusa/server/src/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/test-utils": "2.14.2",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.0.0",
    "bwip-js": "^4.10.1",
    "nanoid": "^5.1.9",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/test-utils": "2.14.2",
    "nanoid": "^5.1.9",
    "qrcode": "^1.5.4",
    "bwip-js": "^4.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.10.0"
}
