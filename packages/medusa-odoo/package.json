{
  "name": "@bambiste/medusa-odoo",
  "version": "0.0.3",
  "description": "Production-grade bidirectional Odoo ERP ↔ MedusaJS v2 integration plugin.",
  "author": "Adafri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bambiste/medusa-plugins.git",
    "directory": "packages/medusa-odoo"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*",
    "./.medusa/server/src/modules/odoo-sync": "./.medusa/server/src/modules/odoo-sync/index.js",
    "./modules/*": "./.medusa/server/src/modules/*",
    ".": "./.medusa/server/src/index.js"
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2",
    "odoo",
    "erp",
    "integration"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/test-utils": "2.14.2",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.10.0"
}
