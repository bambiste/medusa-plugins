{
  "name": "@bambiste/medusa-product-ext",
  "version": "0.0.3",
  "description": "Product extension plugin, extra fields and media (videos) not covered by Medusa's core product model.",
  "author": "Leuzman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bambiste/medusa-plugins.git",
    "directory": "packages/medusa-product-ext"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*",
    "./.medusa/server/src/modules/product-ext": "./.medusa/server/src/modules/product-ext/index.js",
    "./modules/*": "./.medusa/server/src/modules/*",
    "./*": "./.medusa/server/src/*.js",
    ".": "./.medusa/server/src/index.js"
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@medusajs/cli": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/medusa": "2.14.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.10.0"
}
