# Default registry for public packages
registry=https://registry.npmjs.org/

# @bambiste scoped packages → GitHub Packages (github.com/bambiste)
# Auth token goes in ~/.npmrc (local) or NODE_AUTH_TOKEN env var (CI)
@bambiste:registry=https://npm.pkg.github.com/

# Medusa expects a flat node_modules (transitive deps like @medusajs/admin-shared
# must be resolvable). Use a hoisted layout like npm/yarn.
node-linker=hoisted
